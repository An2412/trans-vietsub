{
  "manifest_version": 3,
  "name": "Viet Dub",
  "version": "0.5.5",
  "description": "Dịch phụ đề bằng Gemini, OpenAI, Claude hoặc Ollama; cấu hình API key an toàn trong popup.",
  "action": {
    "default_title": "Viet Dub",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
